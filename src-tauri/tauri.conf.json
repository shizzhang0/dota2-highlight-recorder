{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dota2-highlight-recorder",
  "version": "1.0.1",
  "identifier": "dev.d2hr.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dota 2 高光录制",
        "decorations": false,
        "shadow": true,
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "d2hr overlay",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "width": 400,
        "height": 148
      },
      {
        "label": "prompt",
        "url": "prompt.html",
        "title": "d2hr prompt",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": true,
        "width": 480,
        "height": 240
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://cdn.cloudflare.steamstatic.com; media-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://api.github.com",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwOUY4RURDNkM3MDU5NEUKUldST1dYQnMzSTZmOEloOHVHVVFscDFNYmVTR3RuSlEvejQ2M1pLWTVHOEtxOEhuL0szbjR0cDIK",
      "endpoints": [
        "https://github.com/shizzhang0/dota2-highlight-recorder/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
