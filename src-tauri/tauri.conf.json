{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dota2-highlight-recorder",
  "version": "0.1.0",
  "identifier": "dev.d2hr.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Dota 2 高光录制",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "title": "d2hr overlay",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "focus": false,
        "width": 440,
        "height": 132
      },
      {
        "label": "prompt",
        "url": "prompt.html",
        "title": "d2hr prompt",
        "visible": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "center": true,
        "width": 480,
        "height": 240
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
